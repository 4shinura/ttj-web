{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }} — TrouvetonJob{% endblock %}

{% block body %}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a href="{{ path(isRecruteurView ? 'app_recruteur_offres' : 'app_offre_index') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Retour aux offres
            </a>
            <a href="{{ path('app_offre_edit', {id: offre.id}) }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil"></i> Modifier l'offre
            </a>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
            <span class="statut-badge badge-{{ offre.type|lower }}">
                {{ offre.type }}
            </span>
            <span class="statut-badge badge-{{ offre.statut|lower == 'published' ? 'published' : 'pending' }}">
                {{ offre.statut == 'published' ? 'PUBLIÉE' : 'EN ATTENTE' }}
            </span>
        </div>
        <h1 class="mb-1">{{ offre.titre }}</h1>
        <p class="text-muted small mb-0">
            <i class="bi bi-calendar3 me-1"></i>Publiée le {{ offre.datePublication }}
            &nbsp;·&nbsp;
            <i class="bi bi-calendar-x me-1"></i>Limite : {{ offre.dateLimite }}
        </p>
        <br>
        {% if offre.entreprise is defined and offre.entreprise %}
            <div class="card border rounded-3 bg-white mb-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-start justify-content-between flex-wrap">
                        <div>
                            <h6 class="mb-1 text-uppercase text-secondary small">Entreprise : </h6>
                            <p class="mb-1 fw-semibold">{{ offre.entreprise.raisonSociale }}</p>
                            <p class="text-muted small mb-1">{{ offre.entreprise.adresse }}</p>
                            <p class="text-muted small mb-0">Tél. {{ offre.entreprise.tel }}</p>
                        </div>
                        {% if offre.recruteur is defined and offre.recruteur %}
                            <div class="text-end mt-2 mt-sm-0">
                                <h6 class="mb-1 text-uppercase text-secondary small">Recruteur : </h6>
                                <p class="mb-0 fw-semibold">{{ offre.recruteur.prenom }} {{ offre.recruteur.nom }}</p>
                                <p class="text-muted small mb-0">{{ offre.recruteur.email }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-file-text me-2 text-primary"></i>Description du poste
                </h5>
                <p class="text-muted" style="white-space: pre-line;">{{ offre.description }}</p>
            </div>
        </div>
    </div>
</div>

{% endblock %}