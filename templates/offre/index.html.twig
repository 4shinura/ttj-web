{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi — TrouvetonJob{% endblock %}

{% block body %}

<div class="page-header">
    <div class="container d-flex align-items-center justify-content-between">
        <div>
            <h1><i class="bi bi-search me-2 text-primary"></i>Offres d'emploi</h1>
            <p class="text-muted mb-0 mt-1 small">
                {{ offres|length }} offre{{ offres|length > 1 ? 's' : '' }} disponible{{ offres|length > 1 ? 's' : '' }}
            </p>
        </div>
    </div>
</div>

<div class="container pb-5">

    {% if offres is empty %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-briefcase-fill" style="font-size:3rem;color:#cbd5e1;display:block;margin-bottom:1rem;"></i>
            <h5>Aucune offre disponible</h5>
            <p class="mb-4">Revenez bientôt, de nouvelles offres arrivent régulièrement.</p>
        </div>

    {% else %}
        <div class="row g-4">
            {% for offre in offres %}
                <div class="col-lg-6">
                    <div class="card h-100 p-4">

                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex gap-2 flex-wrap">
                                <span class="statut-badge badge-{{ offre.type|lower }}">
                                    {{ offre.type }}
                                </span>
                                <span class="statut-badge badge-{{ offre.statut|lower == 'published' ? 'published' : 'pending' }}">
                                    {{ offre.statut == 'published' ? 'PUBLIÉE' : 'EN ATTENTE'}}
                                </span>
                            </div>
                            <span class="small text-muted">
                                <i class="bi bi-calendar3 me-1"></i>
                                {{ offre.datePublication }}
                            </span>
                        </div>

                        <h5 class="fw-bold mb-1">{{ offre.titre }}</h5>

                        <p class="small text-muted mb-2">
                            <i class="bi bi-calendar-x me-1"></i>
                            Limite : {{ offre.dateLimite }}
                        </p>

                        <p class="text-muted small mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                            {{ offre.description }}
                        </p>

                        <div class="d-flex align-items-center justify-content-between mt-auto">
                            <a href="{{ path('app_offre_show_published', {id: offre.id}) }}" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>Voir l'offre
                            </a>
                            {% if offre.entreprise is defined and offre.entreprise %}
                                <div class="text-end text-muted small">
                                    <div>Entreprise : </div>
                                    <div class="fw-semibold">{{ offre.entreprise.raisonSociale }}</div>
                                </div>
                            {% endif %}
                        </div>

                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}