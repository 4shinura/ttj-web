{% extends 'base.html.twig' %}

{% block title %}Inscription — TrouvetonJob{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <div class="auth-card">

        <a href="{{ path('app_home') }}" class="auth-logo">
            Trouve<span>Ton</span>Job
        </a>
        <p class="text-center text-muted small mb-4">Créer un compte recruteur</p>

        <h4 class="fw-bold mb-4 text-center">Inscription</h4>

        <form method="post" action="{{ path('app_register') }}">

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label for="nom" class="form-label">Nom</label>
                    <input type="text"
                           id="nom"
                           name="nom_utilisateur"
                           class="form-control"
                           placeholder="Dupont"
                           required>
                </div>
                <div class="col-6">
                    <label for="prenom" class="form-label">Prénom</label>
                    <input type="text"
                           id="prenom"
                           name="prenom_utilisateur"
                           class="form-control"
                           placeholder="Jean"
                           required>
                </div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Adresse e-mail</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email"
                           id="email"
                           name="email_utilisateur"
                           class="form-control"
                           placeholder="votre@email.fr"
                           required>
                </div>
            </div>

            <div class="mb-4">
                <label for="mdp" class="form-label">Mot de passe</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password"
                           id="mdp"
                           name="mdp_utilisateur"
                           class="form-control"
                           placeholder="••••••••"
                           required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-person-plus me-2"></i>Créer mon compte
            </button>
        </form>

        <hr class="my-4">

        <p class="text-center text-muted small mb-0">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-primary fw-500">Se connecter</a>
        </p>

    </div>
</div>
{% endblock %}