{% extends 'base.html.twig' %}

{% block title %}Mes propositions — TrouvetonJob{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-list-check me-2 text-primary"></i>Mes propositions</h1>
            <p class="text-muted mb-0 mt-1 small">Retrouvez les propositions que vous avez créées, avec l'offre associée et leur statut.</p>
        </div>
        <a href="{{ path('app_recruteur_candidatures') }}" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-2"></i>Voir les candidatures
        </a>
    </div>
</div>

<div class="container pb-5">
    {% if propositions is empty %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size:3rem;color:#cbd5e1;display:block;margin-bottom:1rem;"></i>
            <h5>Aucune proposition</h5>
            <p class="mb-0">Vous n'avez pas encore proposé de candidat.</p>
        </div>
    {% else %}
        <div class="card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Candidature</th>
                            <th>Offre</th>
                            <th>Statut</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for proposition in propositions %}
                            <tr>
                                <td>
                                    <div class="fw-semibold">{{ proposition.candidatureCandidat.titre }}</div>
                                    <div class="small text-muted">{{ proposition.candidatureCandidat.competence }} • {{ proposition.candidatureCandidat.typePoste }}</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">{{ proposition.offre.titre }}</div>
                                    <div class="small text-muted">{{ proposition.offre.type }}</div>
                                </td>
                                <td>
                                    <span class="badge bg-{{ proposition.statut == 'accepte' ? 'success' : (proposition.statut == 'refuse' ? 'danger' : 'warning') }}">
                                        {{ proposition.statut }}
                                    </span>
                                </td>
                                <td class="text-muted">{{ proposition.date }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
