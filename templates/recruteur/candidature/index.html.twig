{% extends 'base.html.twig' %}

{% block title %}Candidatures — TrouvetonJob{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-people me-2 text-primary"></i>Candidatures candidates</h1>
            <p class="text-muted mb-0 mt-1 small">Parcourez les candidatures et proposez les profils adaptés aux offres publiées.</p>
        </div>
        <a href="{{ path('app_recruteur_mes_propositions') }}" class="btn btn-outline-primary">
            <i class="bi bi-list-check me-2"></i>Mes propositions
        </a>
    </div>
</div>

<div class="container pb-5">
    <div class="card p-4 mb-4">
        <form method="get" action="{{ path('app_recruteur_candidatures') }}" class="row g-3 align-items-end">
            <div class="col-md-10">
                <label for="q" class="form-label fw-semibold">Recherche</label>
                <input type="text" id="q" name="q" class="form-control" value="{{ searchQuery }}" placeholder="Titre, compétence, type de poste">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Rechercher
                </button>
            </div>
        </form>
    </div>

    {% if candidatures is empty %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-person-x" style="font-size:3rem;color:#cbd5e1;display:block;margin-bottom:1rem;"></i>
            <h5>Aucune candidature trouvée</h5>
            <p class="mb-0">Aucun profil ne correspond à votre recherche.</p>
        </div>
    {% else %}
        <div class="row g-3">
            {% for candidature in candidatures %}
                <div class="col-lg-6">
                    <a href="{{ path('app_recruteur_candidature_show', {id: candidature.id}) }}" class="text-decoration-none">
                        <div class="card p-4 h-100 shadow-sm border-0"> 
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="mb-1 text-dark">{{ candidature.titre }}</h5>
                                    <p class="text-muted small mb-0">{{ candidature.date }}</p>
                                </div>
                                <span class="badge bg-primary-subtle text-primary">{{ candidature.typePoste }}</span>
                            </div>

                            <p class="mt-3 mb-2 text-dark">{{ candidature.description|slice(0, 160) }}{% if candidature.description|length > 160 %}...{% endif %}</p>

                            <div class="d-flex gap-2 flex-wrap mt-3">
                                <span class="badge bg-light text-dark border">{{ candidature.competence }}</span>
                                <span class="badge bg-light text-dark border">{{ candidature.typePoste }}</span>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
