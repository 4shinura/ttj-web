{% extends 'base.html.twig' %}

{% block title %}Nouveau message — TrouvetonJob{% endblock %}

{% block body %}

<div class="page-header">
    <div class="container d-flex align-items-center gap-3">
        <a href="{{ path('message_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
        <h1 class="mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Nouveau message</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card p-4">

                <form id="newMessageForm" action="" method="POST">

                    {# Sélection du destinataire #}
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-person me-1 text-primary"></i>Destinataire
                        </label>

                        {# Champ de recherche / filtrage #}
                        <input type="text" id="userSearch" class="form-control mb-2"
                               placeholder="Rechercher par nom, prénom ou email…"
                               autocomplete="off">

                        {# Liste des utilisateurs #}
                        <div id="userList" class="user-picker-list border rounded overflow-auto"
                             style="max-height: 280px;">
                            {% if utilisateurs is empty %}
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-people" style="font-size:1.5rem;display:block;margin-bottom:.5rem;"></i>
                                    Aucun utilisateur disponible.
                                </div>
                            {% else %}
                                {% for user in utilisateurs %}
                                    <div class="user-option d-flex align-items-center gap-3 p-3"
                                         data-id="{{ user.id }}"
                                         data-search="{{ user.prenom|lower }} {{ user.nom|lower }} {{ user.email|lower }}"
                                         style="{{ not loop.last ? 'border-bottom: 1px solid var(--ttj-border);' : '' }}">

                                        <div class="avatar-circle-sm flex-shrink-0">
                                            {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                                        </div>

                                        <div class="flex-grow-1 min-w-0">
                                            <div class="fw-semibold">{{ user.prenom }} {{ user.nom }}</div>
                                            <div class="small text-muted text-truncate">
                                                <i class="bi bi-envelope me-1"></i>{{ user.email }}
                                            </div>
                                        </div>

                                        <div class="select-indicator">
                                            <i class="bi bi-circle text-muted fs-5"></i>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        {# Champ hidden pour l'id du destinataire sélectionné #}
                        <input type="hidden" name="destinataireId" id="destinataireId" value="">
                        <div id="selectedInfo" class="mt-2 small text-success d-none">
                            <i class="bi bi-check-circle me-1"></i>
                            <span id="selectedName"></span>
                        </div>
                        <div id="noSelectionError" class="mt-2 small text-danger d-none">
                            <i class="bi bi-exclamation-circle me-1"></i>Veuillez sélectionner un destinataire.
                        </div>
                    </div>

                    {# Contenu du message #}
                    <div class="mb-4">
                        <label for="contenu" class="form-label fw-semibold">
                            <i class="bi bi-chat-text me-1 text-primary"></i>Message
                        </label>
                        <textarea id="contenu" name="contenu" class="form-control" rows="5"
                                  placeholder="Écrivez votre message…" required></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('message_index') }}" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary" id="sendBtn">
                            <i class="bi bi-send me-1"></i>Envoyer
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<style>
.avatar-circle-sm {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ttj-blue);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
}
.user-picker-list {
    background: #fff;
    cursor: pointer;
}
.user-option {
    transition: background 0.15s;
}
.user-option:hover {
    background: var(--ttj-light);
}
.user-option.selected {
    background: #eff6ff;
}
.user-option.selected .select-indicator .bi { color: var(--ttj-blue) !important; }
.user-option.d-none { display: none !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const options     = document.querySelectorAll('.user-option');
    const searchInput = document.getElementById('userSearch');
    const hiddenId    = document.getElementById('destinataireId');
    const selectedInfo= document.getElementById('selectedInfo');
    const selectedName= document.getElementById('selectedName');
    const noSelErr    = document.getElementById('noSelectionError');
    const form        = document.getElementById('newMessageForm');

    // Sélection d'un utilisateur
    options.forEach(function(opt) {
        opt.addEventListener('click', function() {
            options.forEach(function(o) {
                o.classList.remove('selected');
                o.querySelector('.select-indicator .bi').className = 'bi bi-circle text-muted fs-5';
            });
            opt.classList.add('selected');
            opt.querySelector('.select-indicator .bi').className = 'bi bi-check-circle-fill fs-5';
            opt.querySelector('.select-indicator .bi').style.color = 'var(--ttj-blue)';

            hiddenId.value = opt.dataset.id;
            selectedName.textContent = opt.querySelector('.fw-semibold').textContent.trim();
            selectedInfo.classList.remove('d-none');
            noSelErr.classList.add('d-none');
        });
    });

    // Filtrage en temps réel
    searchInput.addEventListener('input', function() {
        const q = this.value.toLowerCase().trim();
        options.forEach(function(opt) {
            const match = opt.dataset.search.includes(q);
            opt.classList.toggle('d-none', !match);
        });
    });

    // Soumission : vérification + construction de l'action
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!hiddenId.value) {
            noSelErr.classList.remove('d-none');
            return;
        }
        // On construit l'URL vers la route message_send avec l'id du destinataire
        const baseUrl = "{{ path('message_send', {destinataireId: '__ID__'}) }}".replace('__ID__', hiddenId.value);
        form.action = baseUrl;
        form.submit();
    });
});
</script>

{% endblock %}
